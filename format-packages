#!/usr/bin/env python3
"""test-packages - Fetch and test gren formatter against published packages."""

import argparse
import concurrent.futures
import json
import os
import re
import subprocess
import sys

PACKAGES_URL = "https://packages.gren-lang.org/package"


def fetch_package_list() -> list[tuple[str, str, str]]:
    """Return list of (author, repo, version) from the Gren package registry."""
    result = subprocess.run(
        ["curl", "-sf", PACKAGES_URL],
        capture_output=True,
        text=True,
        check=True,
    )
    html_content = result.stdout

    pattern = r'/package/([^/]+)/([^/]+)/version/([^/]+)/overview'
    seen = set()
    packages = []
    for match in re.finditer(pattern, html_content):
        key = (match.group(1), match.group(2), match.group(3))
        if key not in seen:
            seen.add(key)
            packages.append(key)
    return packages


def clone_package(author: str, repo: str, version: str, cwd: str) -> None:
    dest = os.path.join(cwd, author, repo)
    if os.path.exists(dest):
        print(f"  Already exists, skipping: {author}/{repo}")
        return

    os.makedirs(os.path.join(cwd, author), exist_ok=True)

    github_url = f"https://github.com/{author}/{repo}.git"
    print(f"Cloning {author}/{repo} @ {version} ...")
    subprocess.run(
        ["git", "clone", "--branch", version, "--depth", "1", github_url, dest],
        check=True,
    )


SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
CATEGORY_RE = re.compile(r'^-- ([A-Z][A-Z ]+?) -{2,}', re.MULTILINE)
MIN_GREN_VERSION = (0, 6, 0)


def _find_gren_json_files(search_dir: str) -> list[str]:
    """Return absolute paths of all gren.json files found recursively under search_dir."""
    found = []
    for root, _dirs, files in os.walk(search_dir):
        if "gren.json" in files:
            found.append(os.path.join(root, "gren.json"))
    return found


def _find_gren_files_for_package(package_dir: str) -> list[str]:
    """Return .gren files under package_dir, not descending into nested sub-packages
    (subdirectories that themselves contain a gren.json)."""
    found = []
    for root, dirs, files in os.walk(package_dir):
        if root != package_dir and os.path.isfile(os.path.join(root, "gren.json")):
            dirs[:] = []
            continue
        for f in files:
            if f.endswith(".gren"):
                found.append(os.path.join(root, f))
    return found


def _gren_version_ok(gren_json_path: str) -> bool:
    """Return False if gren.json's upper bound gren-version is below 0.6.0."""
    try:
        with open(gren_json_path) as f:
            data = json.load(f)
        field = data.get("gren-version", "")
        versions = re.findall(r'(\d+)\.(\d+)\.(\d+)', field)
        if not versions:
            return True
        upper = tuple(int(x) for x in versions[-1])
        return upper >= MIN_GREN_VERSION
    except Exception:
        return True


def _parse_category(output: str) -> str:
    if "RangeError: Maximum call stack size exceeded" in output:
        return "STACK OVERFLOW"
    if "FAILED TO PARSE" in output:
        for line in reversed(output.splitlines()):
            line = line.strip()
            if not line or line.startswith(("|", "^", "-")):
                continue
            if re.match(r'^\d+\s*\|', line):
                continue
            return line
        return "FAILED TO PARSE"
    m = CATEGORY_RE.search(output)
    return m.group(1).strip() if m else "UNKNOWN"


def _print_by_category(items: list[tuple[str, str]], label: str) -> None:
    """Print items grouped by category. items is a list of (name, category)."""
    by_category: dict[str, list[str]] = {}
    for name, category in items:
        by_category.setdefault(category, []).append(name)
    print(f"\n{label} by category:")
    for category in sorted(by_category):
        paths = sorted(by_category[category])
        n = len(paths)
        print(f"\n  {category} ({n} {'file' if n == 1 else 'files'}):")
        for path in paths:
            print(f"    {path}")


def _do_fetch(author: str, repo: str, version: str, cwd: str) -> str | None:
    """Clone one package; return the package name on failure, None on success."""
    print(f"Fetching {author}/{repo} ...")
    try:
        clone_package(author, repo, version, cwd)
        return None
    except Exception as exc:
        print(f"  ERROR {author}/{repo}: {exc}", file=sys.stderr)
        return f"{author}/{repo}"


def _do_format_package(gren_json_path: str, gren_sh: str) -> tuple[str, str, bool] | None:
    """Format one package in place; return (gren_json_path, category, timed_out) on
    failure/timeout, None on success."""
    package_dir = os.path.dirname(gren_json_path)
    print(f"Formatting {package_dir} ...")
    try:
        result = subprocess.run(
            [gren_sh],
            cwd=package_dir,
            capture_output=True,
            text=True,
            timeout=5,
        )
        if result.returncode != 0:
            category = _parse_category(result.stdout + result.stderr)
            return (gren_json_path, category, False)
        return None
    except subprocess.TimeoutExpired:
        print(f"  TIMEOUT: {package_dir}", file=sys.stderr)
        return (gren_json_path, "TIMEOUT", True)


def _do_check_package(gren_json_path: str, gren_sh: str) -> tuple[str, str] | None:
    """Try to parse every .gren file belonging to this package with --pre-ast.
    Return None if the whole package parses cleanly, else (gren_json_path, category)
    for the first file that fails (category is "TIMEOUT" on timeout)."""
    package_dir = os.path.dirname(gren_json_path)
    for abs_path in _find_gren_files_for_package(package_dir):
        try:
            result = subprocess.run(
                [gren_sh, f"--pre-ast={abs_path}"],
                capture_output=True,
                text=True,
                timeout=5,
            )
            if result.returncode != 0:
                category = _parse_category(result.stdout + result.stderr)
                return (gren_json_path, category)
        except subprocess.TimeoutExpired:
            return (gren_json_path, "TIMEOUT")
    return None


def cmd_check(args) -> None:
    cwd = os.getcwd()
    gren_sh = os.path.join(SCRIPT_DIR, "gren-format.sh")

    if args.packages:
        search_dirs = []
        for pkg in args.packages:
            dest = os.path.join(cwd, pkg)
            if not os.path.isdir(dest):
                print(f"Not found locally, skipping: {pkg}", file=sys.stderr)
                continue
            search_dirs.append(dest)
    else:
        search_dirs = [cwd]

    gren_json_paths = set()
    for search_dir in search_dirs:
        gren_json_paths.update(_find_gren_json_files(search_dir))

    to_check = []
    skipped = []      # list of rel_path
    for gren_json_path in sorted(gren_json_paths):
        rel_path = os.path.relpath(gren_json_path, cwd)
        if not _gren_version_ok(gren_json_path):
            print(f"Skipping due to gren version: {rel_path}")
            skipped.append(rel_path)
        else:
            to_check.append(gren_json_path)

    n_ok = 0
    working = []      # list of gren_json_path (abs)
    failed = []       # list of (rel_path, category)
    timed_out = []    # list of (rel_path, category)
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.j) as pool:
        futures = {
            pool.submit(_do_check_package, gren_json_path, gren_sh): gren_json_path
            for gren_json_path in to_check
        }
        for fut in concurrent.futures.as_completed(futures):
            gren_json_path = futures[fut]
            print(f"Checked {os.path.relpath(gren_json_path, cwd)}")
            result = fut.result()
            if result is None:
                n_ok += 1
                working.append(gren_json_path)
            else:
                _, category = result
                rel_path = os.path.relpath(gren_json_path, cwd)
                (timed_out if category == "TIMEOUT" else failed).append((rel_path, category))

    working_paths = sorted(os.path.relpath(p, cwd) for p in working)
    with open("checked.txt", "w") as f:
        f.write("\n".join(working_paths))
        if working_paths:
            f.write("\n")

    failed_paths = [p for p, _ in failed]
    timed_out_paths = [p for p, _ in timed_out]

    with open("failed.txt", "w") as f:
        f.write("\n".join(sorted(failed_paths)))
        if failed_paths:
            f.write("\n")
    with open("timedout.txt", "w") as f:
        f.write("\n".join(sorted(timed_out_paths)))
        if timed_out_paths:
            f.write("\n")
    with open("skipped.txt", "w") as f:
        f.write("\n".join(sorted(skipped)))
        if skipped:
            f.write("\n")

    print(f"\nSuccessful: {n_ok}")
    print(f"Skipped:    {len(skipped)}")
    print(f"Failed:     {len(failed)}")
    print(f"Timed out:  {len(timed_out)}")
    print("\nWrote passing package list to checked.txt")
    if skipped:
        print("\nSkipped packages:")
        for path in sorted(skipped):
            print(f"  {path}")
    if failed:
        _print_by_category(failed, "Failed packages")
    if timed_out:
        _print_by_category(timed_out, "Timed out packages")


def _print_failures(failed: list[str]) -> None:
    if failed:
        print(f"\nFailed ({len(failed)}):", file=sys.stderr)
        for pkg in failed:
            print(f"  {pkg}", file=sys.stderr)


def cmd_fetch(args) -> None:
    cwd = os.getcwd()

    print("Fetching package list ...")
    if args.packages:
        all_packages = fetch_package_list()
        pkg_map = {f"{a}/{r}": (a, r, v) for a, r, v in all_packages}
        targets = []
        for pkg_name in args.packages:
            if pkg_name not in pkg_map:
                print(f"Unknown package: {pkg_name}", file=sys.stderr)
                sys.exit(1)
            targets.append(pkg_map[pkg_name])
    else:
        targets = fetch_package_list()

    failed = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.j) as pool:
        futures = {
            pool.submit(_do_fetch, a, r, v, cwd): f"{a}/{r}"
            for a, r, v in targets
        }
        for fut in concurrent.futures.as_completed(futures):
            result = fut.result()
            if result is not None:
                failed.append(result)

    _print_failures(failed)


def cmd_format(args) -> None:
    cwd = os.getcwd()
    gren_sh = os.path.join(SCRIPT_DIR, "gren-format.sh")

    if not os.path.isfile(args.input):
        print(f"Input file not found: {args.input}", file=sys.stderr)
        print("Run 'format-packages check' first to generate it.", file=sys.stderr)
        sys.exit(1)

    with open(args.input) as f:
        rel_paths = [line.strip() for line in f if line.strip()]

    if args.packages:
        prefixes = tuple(f"{pkg}{os.sep}" for pkg in args.packages)
        rel_paths = [p for p in rel_paths if p.startswith(prefixes)]

    targets = []
    for rel_path in rel_paths:
        gren_json_path = os.path.join(cwd, rel_path)
        if not os.path.isfile(gren_json_path):
            print(f"Not found, skipping: {rel_path}", file=sys.stderr)
        else:
            targets.append(gren_json_path)

    failed = []       # list of (rel_path, category)
    timed_out = []    # list of (rel_path, category)
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.j) as pool:
        futures = {
            pool.submit(_do_format_package, gren_json_path, gren_sh): gren_json_path
            for gren_json_path in targets
        }
        for fut in concurrent.futures.as_completed(futures):
            gren_json_path = futures[fut]
            result = fut.result()
            if result is not None:
                _, category, is_timeout = result
                rel_path = os.path.relpath(gren_json_path, cwd)
                (timed_out if is_timeout else failed).append((rel_path, category))

    failed_paths = [p for p, _ in failed]
    timed_out_paths = [p for p, _ in timed_out]

    with open("format_failed.txt", "w") as f:
        f.write("\n".join(sorted(failed_paths)))
        if failed_paths:
            f.write("\n")
    with open("format_timedout.txt", "w") as f:
        f.write("\n".join(sorted(timed_out_paths)))
        if timed_out_paths:
            f.write("\n")

    _print_failures(failed_paths)
    if failed:
        _print_by_category(failed, "Failed packages")
    if timed_out:
        print(f"\nTimed out ({len(timed_out)}):", file=sys.stderr)
        for pkg, _ in timed_out:
            print(f"  {pkg}", file=sys.stderr)
        _print_by_category(timed_out, "Timed out packages")


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Tool for testing the gren formatter against published packages."
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    fetch_parser = subparsers.add_parser(
        "fetch",
        help="Clone git repos for gren packages",
    )
    fetch_parser.add_argument(
        "packages",
        nargs="*",
        metavar="AUTHOR/REPO",
        help="Packages to fetch (e.g. aramiscd/gren-color). Fetches all if omitted.",
    )
    fetch_parser.add_argument(
        "-j", type=int, default=1, metavar="N", help="Parallel workers (default 1)."
    )
    fetch_parser.set_defaults(func=cmd_fetch)

    format_parser = subparsers.add_parser(
        "format",
        help="Run gren-format.sh on packages listed in the check output file",
    )
    format_parser.add_argument(
        "packages",
        nargs="*",
        metavar="AUTHOR/REPO",
        help="Restrict formatting to these packages. Formats every package listed "
        "in the input file if omitted.",
    )
    format_parser.add_argument(
        "-i",
        "--input",
        default="checked.txt",
        metavar="PATH",
        help="File listing gren.json paths to format, one per line (default: checked.txt, "
        "as produced by the check subcommand).",
    )
    format_parser.add_argument(
        "-j", type=int, default=1, metavar="N", help="Parallel workers (default 1)."
    )
    format_parser.set_defaults(func=cmd_format)

    check_parser = subparsers.add_parser(
        "check",
        help="Find gren.json files and check whether their packages parse",
    )
    check_parser.add_argument(
        "packages",
        nargs="*",
        metavar="AUTHOR/REPO",
        help="Packages to check. Searches the whole current directory tree if omitted.",
    )
    check_parser.add_argument(
        "-j", type=int, default=1, metavar="N", help="Parallel workers (default 1)."
    )
    check_parser.set_defaults(func=cmd_check)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
