#!/usr/bin/env python3
"""test-packages - Fetch and test gren formatter against published packages."""

import argparse
import concurrent.futures
import os
import re
import subprocess
import sys

PACKAGES_URL = "https://packages.gren-lang.org/package"


def fetch_package_list() -> list[tuple[str, str, str]]:
    """Return list of (author, repo, version) from the Gren package registry."""
    result = subprocess.run(
        ["curl", "-sf", PACKAGES_URL],
        capture_output=True,
        text=True,
        check=True,
    )
    html_content = result.stdout

    pattern = r'/package/([^/]+)/([^/]+)/version/([^/]+)/overview'
    seen = set()
    packages = []
    for match in re.finditer(pattern, html_content):
        key = (match.group(1), match.group(2), match.group(3))
        if key not in seen:
            seen.add(key)
            packages.append(key)
    return packages


def clone_package(author: str, repo: str, version: str, cwd: str) -> None:
    dest = os.path.join(cwd, author, repo)
    if os.path.exists(dest):
        print(f"  Already exists, skipping: {author}/{repo}")
        return

    os.makedirs(os.path.join(cwd, author), exist_ok=True)

    github_url = f"https://github.com/{author}/{repo}.git"
    print(f"Cloning {author}/{repo} @ {version} ...")
    subprocess.run(
        ["git", "clone", "--branch", version, "--depth", "1", github_url, dest],
        check=True,
    )


SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))


def _do_fetch(author: str, repo: str, version: str, cwd: str) -> str | None:
    """Clone one package; return the package name on failure, None on success."""
    print(f"Fetching {author}/{repo} ...")
    try:
        clone_package(author, repo, version, cwd)
        return None
    except Exception as exc:
        print(f"  ERROR {author}/{repo}: {exc}", file=sys.stderr)
        return f"{author}/{repo}"


def _do_format(pkg: str, dest: str, gren_sh: str) -> tuple[str, bool] | None:
    """Format one package; return (pkg, timed_out) on failure/timeout, None on success."""
    print(f"Formatting {pkg} ...")
    try:
        result = subprocess.run(
            [gren_sh, "format", "--dangerous"], cwd=dest, timeout=5
        )
        if result.returncode != 0:
            return (pkg, False)
        return None
    except subprocess.TimeoutExpired:
        print(f"  TIMEOUT: {pkg}", file=sys.stderr)
        return (pkg, True)


def _find_gren_files(package_dir: str) -> list[str]:
    """Return absolute paths of all .gren files under package_dir."""
    found = []
    for root, _dirs, files in os.walk(package_dir):
        for f in files:
            if f.endswith(".gren"):
                found.append(os.path.join(root, f))
    return found


def _do_check(rel_path: str, abs_path: str, gren_sh: str) -> tuple[str, bool] | None:
    """Check one file; return (rel_path, timed_out) on failure/timeout, None on success."""
    try:
        result = subprocess.run(
            [gren_sh, "format", f"--check={abs_path}"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        output = (result.stdout + result.stderr).strip()
        if "Success" in output:
            return None
        return (rel_path, False)
    except subprocess.TimeoutExpired:
        print(f"  TIMEOUT: {rel_path}", file=sys.stderr)
        return (rel_path, True)


def cmd_check(args) -> None:
    cwd = os.getcwd()
    gren_sh = os.path.join(SCRIPT_DIR, "gren.sh")

    if args.packages:
        pkg_names = args.packages
    else:
        all_packages = fetch_package_list()
        pkg_names = [
            f"{author}/{repo}"
            for author, repo, _ in all_packages
            if os.path.isdir(os.path.join(cwd, author, repo))
        ]

    files_to_check = []
    for pkg in pkg_names:
        dest = os.path.join(cwd, pkg)
        if not os.path.isdir(dest):
            print(f"Not found locally, skipping: {pkg}", file=sys.stderr)
            continue
        print(f"Checking {pkg} ...")
        for abs_path in _find_gren_files(dest):
            rel_path = os.path.relpath(abs_path, cwd)
            files_to_check.append((rel_path, abs_path))

    n_ok = 0
    failed = []
    timed_out = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.j) as pool:
        futures = {
            pool.submit(_do_check, rel, abs_path, gren_sh): rel
            for rel, abs_path in files_to_check
        }
        for fut in concurrent.futures.as_completed(futures):
            result = fut.result()
            if result is None:
                n_ok += 1
            else:
                path, is_timeout = result
                (timed_out if is_timeout else failed).append(path)

    with open("failed.txt", "w") as f:
        f.write("\n".join(sorted(failed)))
        if failed:
            f.write("\n")
    with open("timedout.txt", "w") as f:
        f.write("\n".join(sorted(timed_out)))
        if timed_out:
            f.write("\n")

    print(f"\nSuccessful: {n_ok}")
    print(f"Failed:     {len(failed)}")
    print(f"Timed out:  {len(timed_out)}")
    if failed:
        print("\nFailed files:")
        for path in sorted(failed):
            print(f"  {path}")
    if timed_out:
        print("\nTimed out files:")
        for path in sorted(timed_out):
            print(f"  {path}")


def _print_failures(failed: list[str]) -> None:
    if failed:
        print(f"\nFailed ({len(failed)}):", file=sys.stderr)
        for pkg in failed:
            print(f"  {pkg}", file=sys.stderr)


def cmd_fetch(args) -> None:
    cwd = os.getcwd()

    print("Fetching package list ...")
    if args.packages:
        all_packages = fetch_package_list()
        pkg_map = {f"{a}/{r}": (a, r, v) for a, r, v in all_packages}
        targets = []
        for pkg_name in args.packages:
            if pkg_name not in pkg_map:
                print(f"Unknown package: {pkg_name}", file=sys.stderr)
                sys.exit(1)
            targets.append(pkg_map[pkg_name])
    else:
        targets = fetch_package_list()

    failed = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.j) as pool:
        futures = {
            pool.submit(_do_fetch, a, r, v, cwd): f"{a}/{r}"
            for a, r, v in targets
        }
        for fut in concurrent.futures.as_completed(futures):
            result = fut.result()
            if result is not None:
                failed.append(result)

    _print_failures(failed)


def cmd_format(args) -> None:
    cwd = os.getcwd()
    gren_sh = os.path.join(SCRIPT_DIR, "gren.sh")

    if args.packages:
        pkg_names = args.packages
    else:
        all_packages = fetch_package_list()
        pkg_names = [
            f"{author}/{repo}"
            for author, repo, _ in all_packages
            if os.path.isdir(os.path.join(cwd, author, repo))
        ]

    targets = []
    for pkg in pkg_names:
        dest = os.path.join(cwd, pkg)
        if not os.path.isdir(dest):
            print(f"Not found locally, skipping: {pkg}", file=sys.stderr)
        else:
            targets.append((pkg, dest))

    failed = []
    timed_out = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.j) as pool:
        futures = {
            pool.submit(_do_format, pkg, dest, gren_sh): pkg
            for pkg, dest in targets
        }
        for fut in concurrent.futures.as_completed(futures):
            result = fut.result()
            if result is not None:
                pkg, is_timeout = result
                (timed_out if is_timeout else failed).append(pkg)

    _print_failures(failed)
    if timed_out:
        print(f"\nTimed out ({len(timed_out)}):", file=sys.stderr)
        for pkg in timed_out:
            print(f"  {pkg}", file=sys.stderr)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Tool for testing the gren formatter against published packages."
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    fetch_parser = subparsers.add_parser(
        "fetch",
        help="Clone git repos for gren packages",
    )
    fetch_parser.add_argument(
        "packages",
        nargs="*",
        metavar="AUTHOR/REPO",
        help="Packages to fetch (e.g. aramiscd/gren-color). Fetches all if omitted.",
    )
    fetch_parser.add_argument(
        "-j", type=int, default=1, metavar="N", help="Parallel workers (default 1)."
    )
    fetch_parser.set_defaults(func=cmd_fetch)

    format_parser = subparsers.add_parser(
        "format",
        help="Run gren format --dangerous on cloned packages",
    )
    format_parser.add_argument(
        "packages",
        nargs="*",
        metavar="AUTHOR/REPO",
        help="Packages to format. Formats all locally cloned packages if omitted.",
    )
    format_parser.add_argument(
        "-j", type=int, default=1, metavar="N", help="Parallel workers (default 1)."
    )
    format_parser.set_defaults(func=cmd_format)

    check_parser = subparsers.add_parser(
        "check",
        help="Check formatting of .gren files in cloned packages",
    )
    check_parser.add_argument(
        "packages",
        nargs="*",
        metavar="AUTHOR/REPO",
        help="Packages to check. Checks all locally cloned packages if omitted.",
    )
    check_parser.add_argument(
        "-j", type=int, default=1, metavar="N", help="Parallel workers (default 1)."
    )
    check_parser.set_defaults(func=cmd_check)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
