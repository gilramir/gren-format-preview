#!/usr/bin/env python3
"""Clone gren-format compiler repos into the current working directory."""

import subprocess

REPOS = [
    "https://github.com/gilramir/gren-format.git",
    "https://github.com/gilramir/gren-format-lib.git",
]


def repo_name(url):
    return url.removesuffix(".git").rsplit("/", 1)[-1]


def clone_and_configure(url):
    name = repo_name(url)
    print(f"Cloning {url} ...")
    subprocess.run(["git", "clone", url, name], check=True)
    print("  Checking out main branch")
    subprocess.run(
        ["git", "-C", name, "checkout", "main"],
        check=True,
    )


def main() -> None:
    for url in REPOS:
        clone_and_configure(url)

    print("\nDone.")


if __name__ == "__main__":
    main()
