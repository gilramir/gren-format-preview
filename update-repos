#!/usr/bin/env python3
"""Run 'git pull' in any of the gren-format compiler repos that exist on disk."""

import os
import subprocess

REPOS = [
    "https://github.com/gilramir/gren-compiler.git",
    "https://github.com/gilramir/gren-compiler-node.git",
    "https://github.com/gilramir/gren-compiler-common.git",
]


def repo_name(url: str) -> str:
    return url.removesuffix(".git").rsplit("/", 1)[-1].lstrip("gren-")


def pull_if_exists(url: str) -> None:
    name = repo_name(url)
    if not os.path.isdir(name):
        print(f"Skipping {name} (not found on disk)")
        return
    print(f"Pulling {name} ...")
    subprocess.run(["git", "-C", name, "pull"], check=True)


def main() -> None:
    for url in REPOS:
        pull_if_exists(url)

    print("\nDone.")


if __name__ == "__main__":
    main()
